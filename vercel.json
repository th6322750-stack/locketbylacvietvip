{
  "version": 2,
  "name": "locketbylacvietvip",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/LacVietMedia.mobileconfig",
      "headers": {
        "Content-Type": "application/x-apple-aspen-config"
      },
      "dest": "/server.js"
    },
    {
      "src": "/vanduclocket.mobileconfig",
      "headers": {
        "Content-Type": "application/x-apple-aspen-config"
      },
      "dest": "/server.js"
    },
    {
      "src": "/get_config.php",
      "headers": {
        "Content-Type": "application/x-apple-aspen-config"
      },
      "dest": "/server.js"
    },
    {
      "src": "/get_avatar.php",
      "dest": "/server.js"
    },
    {
      "src": "/queue_api.php",
      "dest": "/server.js"
    },
    {
      "src": "/locket.sgmodule",
      "dest": "/server.js"
    },
    {
      "src": "/locket.js",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    },
    {
      "src": "/admin/",
      "dest": "/public/admin.html"
    },
    {
      "src": "/shop",
      "dest": "/public/index.html"
    },
    {
      "src": "/shop/",
      "dest": "/public/index.html"
    },
    {
      "src": "/store",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
